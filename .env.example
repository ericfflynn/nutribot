APP_USERS=Eric
APP_USER_PASSWORDS=Eric:replace-with-eric-password
AUTH_SECRET=replace-with-long-random-secret
APP_TIME_ZONE=America/New_York

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Optional alternative to DATABASE_URL:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Google Health sync (npm run health:sync). Read-only OAuth client and refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_HEALTH_USER=Eric
