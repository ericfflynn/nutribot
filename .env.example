APP_USERS=Eric
APP_USER_PASSWORDS=Eric:replace-with-eric-password
AUTH_SECRET=replace-with-long-random-secret
APP_TIME_ZONE=America/New_York

# Chat brain (docs/brain.md): issue with `claude setup-token`. Leave ANTHROPIC_API_KEY unset.
CLAUDE_CODE_OAUTH_TOKEN=
# Optional; defaults to claude-sonnet-5-5.
CLAUDE_MODEL=

DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Google Health sync (npm run health:sync). Read-only OAuth client and refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_HEALTH_USER=Eric

# Daily health sync (Vercel Cron). Any long random string.
CRON_SECRET=

# Web push reminders. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional contact for push services; defaults to the production URL.
VAPID_SUBJECT=
