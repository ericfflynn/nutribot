{
  "name": "nutribot-macro-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "test": "node --import tsx --test tests/*.test.ts",
    "start": "next start",
    "health:sync": "node --env-file=.env.local --import tsx scripts/health-sync.ts",
    "health:auth": "node --env-file=.env.local --import tsx scripts/health-auth.ts",
    "workouts:dedupe": "node --env-file=.env.local --import tsx scripts/workout-dedupe.ts",
    "feedback": "node --env-file=.env.local --import tsx scripts/feedback.ts",
    "demo:seed": "node --env-file-if-exists=.env.local --import tsx scripts/demo-seed.ts",
    "brain": "node --env-file=.env.local --import tsx scripts/brain.ts",
    "body:states": "node --env-file=.env.local --import tsx scripts/body-states.ts",
    "db:backup": "scripts/db-backup.sh"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "next": "^15.3.2",
    "pg": "^8.21.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3"
  }
}
